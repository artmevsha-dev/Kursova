/* Базові налаштування */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Montserrat', sans-serif;
}

body {
    background-color: #f8f9fa;
    color: #333;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Навігація */
.navbar {
    background-color: #2E7D32; /* Темно-зелений */
    padding: 20px 0;
    color: white;
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 24px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: 700;
    transition: color 0.3s;
}

nav a:hover, nav a.active {
    color: #FFB300; /* Жовтий акцент */
}

.btn-login {
    background-color: transparent;
    border: 2px solid #FFB300;
    color: #FFB300;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: 700;
    transition: 0.3s;
}

.btn-login:hover {
    background-color: #FFB300;
    color: #2E7D32;
}

/* Головний банер */
.hero {
    /* Беремо картинку з Unsplash для фону */
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1537225228614-56cc3556d7ed?auto=format&fit=crop&w=1920&q=80') center/cover;
    height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

.hero-content h1 {
    font-size: 56px;
    font-weight: 900;
    margin-bottom: 20px;
    letter-spacing: 2px;
}

.hero-content p {
    font-size: 20px;
    margin-bottom: 40px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

.btn-primary {
    background-color: #E65100; /* Яскраво-помаранчевий */
    color: white;
    padding: 15px 40px;
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    transition: background-color 0.3s;
}

.btn-primary:hover {
    background-color: #BF360C;
}

/* Переваги */
.features {
    padding: 80px 0;
    text-align: center;
}

.section-title {
    font-size: 36px;
    color: #2E7D32;
    margin-bottom: 50px;
}

.features-grid {
    display: flex;
    justify-content: space-between;
    gap: 30px;
}

.feature-card {
    background: white;
    padding: 40px 20px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    flex: 1;
}

.feature-card .icon {
    font-size: 50px;
    margin-bottom: 20px;
}

.feature-card h3 {
    color: #E65100;
    margin-bottom: 15px;
    font-size: 22px;
}
